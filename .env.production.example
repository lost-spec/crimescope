# ---- Required in production ----
# Copy the variable NAME into Vercel (Settings > Environment Variables).
# The variable NAME is all that matters; the empty value below is just documentation.

# https://gnews.io/register
GNEWS_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Optional, override the defaults ----
# Any chat model id from https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Must be your real deployed origin or OpenRouter rejects the request.
# Vercel exposes VERCEL_PROJECT_PRODUCTION_URL for you.
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_SITE_NAME=CrimeScope

# Set on Vercel so the server skips app.listen() and exports the handler.
VERCEL=1

# ---- Serverless notes ----
# PORT and HOST are ignored on Vercel; the platform injects its own.
# The Vercel filesystem is read-only apart from /tmp, so leave STORY_DATA_DIR
# unset and the story shelf falls back to in-memory (lost on cold start).
# For stories that persist, mount a writable path or swap the store for a database.
# STORY_DATA_DIR=/tmp/stories

# GNEWS_COUNTRY=US
# GNEWS_LANG=en
# STORY_MODEL_TEMPERATURE=0.85
# STORY_MAX_SOURCES=8
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# GEOCODER_USER_AGENT=CrimeScope/0.1 (your-app.vercel.app)