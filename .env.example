# ---- Server ----
# Keys are read from real environment variables first, then from a .env file here.
# Export GNEWS_API_KEY / OPENROUTER_API_KEY in your shell, CI, or host panel and it
# wins over anything written in .env. Never commit .env.
PORT=3000
HOST=127.0.0.1

# ---- GNews (https://gnews.io) ----
# Free key: https://gnews.io/register
GNEWS_API_KEY=
# GNews caps "max" per plan: 10 Free, 25 Essential, 50 Business, 100 Enterprise.
# Exceeding your plan's cap returns HTTP 400, so this must match your plan.
GNEWS_MAX_RESULTS=10
# GNews rejects any "q" longer than 200 characters.
GNEWS_QUERY_MAX_CHARS=200
# Days of history your plan keeps. Free keeps 30; paid goes back to 2020.
# A window longer than this is capped rather than returning nothing.
GNEWS_HISTORY_DAYS=30
# GNews allows 1 request/second on the free plan, 10/second on paid. One search
# can need several calls (the fallback ladder), so calls are spaced by this gap.
# Raise it to 100 if you are on a paid plan.
GNEWS_MIN_INTERVAL_MS=1100
# How long a GNews response is reused before refetching, in ms.
# Set to 0 to disable the cache.
GNEWS_CACHE_TTL_MS=300000

# ---- OpenRouter (https://openrouter.ai) ----
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any chat model on https://openrouter.ai/models works.
# Default is free. Expect weaker prose than a frontier model on long stories.
# Note: this model has no response_format support, so the JSON contract in
# server/services/stories.js relies on prompting plus the salvage/retry path.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Identifies your app in the OpenRouter dashboard
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=CrimeScope

# ---- Geocoding (OpenStreetMap Nominatim, keyless) ----
# Optional: use a commercial geocoder here by setting GEOCODER_URL
GEOCODER_URL=https://nominatim.openstreetmap.org/search

# ---- Story generation tuning ----
STORY_MODEL_TEMPERATURE=0.85
# How many news articles get fed into one generated story
STORY_MAX_SOURCES=8